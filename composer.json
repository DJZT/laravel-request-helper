{
    "name": "djzt/laravel-helpers",
    "description": "Laravel helpers in one package: typed request accessors with an explicit Optional marker, and formatting helpers for API resources — dates, money, enums, files, conditional attributes.",
    "keywords": [
        "laravel",
        "helpers",
        "request",
        "form-request",
        "resource",
        "json-resource",
        "dto",
        "optional",
        "nullable",
        "typed",
        "formatting"
    ],
    "homepage": "https://github.com/DJZT/laravel-helpers",
    "license": "MIT",
    "authors": [
        {
            "name": "DJZT",
            "email": "djzt44@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0",
        "nesbot/carbon": "^3.8.4"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "DJZT\\Helpers\\": "src/",
            "DJZT\\RequestHelper\\": "src/Request/",
            "Djzt\\ResourceHelper\\": "src/Resource/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DJZT\\Helpers\\Tests\\": "tests/Package/",
            "DJZT\\RequestHelper\\Tests\\": "tests/Request/",
            "Djzt\\ResourceHelper\\Tests\\": "tests/Resource/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "lint": "vendor/bin/pint --test",
        "format": "vendor/bin/pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "DJZT\\Helpers\\HelpersServiceProvider"
            ],
            "aliases": {
                "ResourceHelper": "Djzt\\ResourceHelper\\Facades\\ResourceHelper"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
